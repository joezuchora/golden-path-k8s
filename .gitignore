# Pinned CLIs installed by `make tools` (D-048)
.bin/

# Chainsaw JUnit reports (make e2e)
.e2e-reports/

# Policies rendered by scripts/test-policies.sh for kyverno test
platform/policies/tests/.rendered/

# Helm dependency downloads (helm dependency build); Chart.lock pins them
platform/components/*/charts/

# kind kubeconfig used by the Makefile
.kube/

# Terraform (D-083, D-088): provider caches, state and filled-in tfvars never enter Git; .terraform.lock.hcl does.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.auto.tfvars
infra/**/tfplan*

# Claude Code (D-107): .claude/settings.json and .claude/agents/ are shared; local settings and worktrees are not.
.claude/settings.local.json
.claude/worktrees/
