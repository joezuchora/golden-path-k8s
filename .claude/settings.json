{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git commit*--no-verify*)",
      "Bash(git push*--no-verify*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)"
    ],
    "ask": [
      "Bash(make aks-up*)",
      "Bash(make aks-down*)",
      "Bash(*infra/aks/aks.sh up*)",
      "Bash(*infra/aks/aks.sh down*)",
      "Bash(terraform *apply*)",
      "Bash(terraform *destroy*)",
      "Bash(make kind-up*)",
      "Bash(make kind-down*)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/quick-check.sh\" --hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
