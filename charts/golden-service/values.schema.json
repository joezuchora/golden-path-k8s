{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "golden-service 1.x values (Developer Contract v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "env", "image"],
  "properties": {
    "global": {"type": "object"},
    "app": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}[a-z0-9]$"},
    "env": {"type": "string", "enum": ["dev", "test", "prod"]},
    "image": {"type": "string", "minLength": 1, "description": "<registry>/<repo>@sha256:<digest> (a tag-only reference is mutated to a digest at admission)"},
    "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "replicas": {"type": "integer", "minimum": 0, "maximum": 20},
    "progressDeadlineSeconds": {"type": "integer", "minimum": 30, "maximum": 3600},
    "args": {"type": "array", "items": {"type": "string"}},
    "extraEnv": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$", "not": {"pattern": "^DB_"}}
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "required": ["cpu", "memory"]},
        "limits": {"type": "object", "required": ["memory"]}
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"readinessPath": {"type": "string"}, "livenessPath": {"type": "string"}}
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "pathPrefix": {"type": "string", "pattern": "^/"},
        "headerMatches": {"type": "array", "items": {"type": "object", "required": ["name", "value"], "additionalProperties": false,
          "properties": {"name": {"type": "string"}, "value": {"type": "string"}}}},
        "requestHeaders": {"$ref": "#/definitions/headerModifier"},
        "responseHeaders": {"$ref": "#/definitions/headerModifier"}
      }
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}, "image": {"type": "string"}, "weight": {"type": "integer", "minimum": 0, "maximum": 100}}
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"postgres": {"type": "array", "maxItems": 1, "description": "v1: one database per app; its credentials arrive as DB_* variables (D-062)", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$"}}}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean", "description": "Mount the app's federated token and identity IDs; needs an AppIdentity named after the app (ADR-0013)"}}
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowFromApps": {"$ref": "#/definitions/appPorts"},
        "allowToApps": {"$ref": "#/definitions/appPorts"}
      }
    },
    "platform": {"type": "object"}
  },
  "definitions": {
    "headerModifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set": {"type": "object", "additionalProperties": {"type": "string"}},
        "add": {"type": "object", "additionalProperties": {"type": "string"}},
        "remove": {"type": "array", "items": {"type": "string"}}
      }
    },
    "appPorts": {
      "type": "array",
      "items": {"type": "object", "required": ["app", "port"], "additionalProperties": false,
        "properties": {"app": {"type": "string"}, "port": {"type": "integer"}}}
    }
  }
}
